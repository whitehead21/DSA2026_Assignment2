import ballerina/http;
import ballerina/log;
import ballerina/time;
import ballerinax/mongodb;
import ballerinax/kafka;

// ---------- Data types ----------

type OrderItem record {
    string itemName;
    int quantity;
    decimal price;
};

type ConfirmedOrder record {
    string orderId;
    string customerId;
    string restaurantId;
    OrderItem[] items;
    decimal totalAmount;
    string status;
};

type AcceptedOrder record {
    string orderId;
    string restaurantId;
    OrderItem[] items;
    string status;
};

// One dish on the menu, with its price and how many are left
type MenuItem record {
    string itemName;
    decimal price;
    int stock;
};

// A restaurant, its kitchen hours (local time, "HH:MM") and its menu.
// The menu is stored inside the restaurant document because it is small
// and always read together with the restaurant.
type Restaurant record {
    string restaurantId;
    string name;
    string openingTime;
    string closingTime;
    MenuItem[] menu;
};

// Request bodies
type NewRestaurant record {
    string restaurantId;
    string name;
    string openingTime;
    string closingTime;
};

type OpeningHours record {
    string openingTime;
    string closingTime;
};

type MenuItemUpdate record {
    decimal price;
    int stock;
};

// ---------- Configuration and clients ----------

configurable string mongoHost = "localhost";
configurable int mongoPort = 27017;
configurable string kafkaBootstrap = "localhost:9092";

// Time zone of the opening hours (Namibia is UTC+2)
configurable int utcOffsetHours = 2;

mongodb:Client mongoClient = check new ({
    connection: string `mongodb://${mongoHost}:${mongoPort}`
});

kafka:Producer restaurantProducer = check new (kafkaBootstrap);

function restaurantsCollection() returns mongodb:Collection|error {
    mongodb:Database restaurantDb = check mongoClient->getDatabase("restaurantdb");
    mongodb:Collection restaurants = check restaurantDb->getCollection("restaurants");
    return restaurants;
}

function acceptedOrdersCollection() returns mongodb:Collection|error {
    mongodb:Database restaurantDb = check mongoClient->getDatabase("restaurantdb");
    mongodb:Collection acceptedOrders = check restaurantDb->getCollection("acceptedOrders");
    return acceptedOrders;
}

// Publishes an event with the orderId as its Kafka key
function publishEvent(string topic, string orderId, json event) returns error? {
    kafka:BytesProducerRecord producerRecord = {
        topic: topic,
        key: orderId.toBytes(),
        value: event.toJsonString().toBytes()
    };
    check restaurantProducer->send(producerRecord);
    log:printInfo("Published " + topic + " for order " + orderId);
}

// ---------- Opening hours ----------

// Turns "HH:MM" into minutes after midnight
function toMinutes(string hhmm) returns int|error {
    int? colon = hhmm.indexOf(":");
    if colon is () {
        return error("Times must look like HH:MM, for example 08:30");
    }
    int hours = check int:fromString(hhmm.substring(0, colon));
    int minutes = check int:fromString(hhmm.substring(colon + 1));
    if hours < 0 || hours > 23 || minutes < 0 || minutes > 59 {
        return error("Times must look like HH:MM, for example 08:30");
    }
    return hours * 60 + minutes;
}

function validHours(string openingTime, string closingTime) returns boolean {
    return toMinutes(openingTime) is int && toMinutes(closingTime) is int;
}

function isOpenNow(Restaurant restaurant) returns boolean|error {
    int localSeconds = time:utcNow()[0] + utcOffsetHours * 3600;
    int nowMinutes = (localSeconds % 86400) / 60;
    int opens = check toMinutes(restaurant.openingTime);
    int closes = check toMinutes(restaurant.closingTime);
    if opens <= closes {
        return nowMinutes >= opens && nowMinutes < closes;
    }
    // Open past midnight, for example 18:00 to 02:00
    return nowMinutes >= opens || nowMinutes < closes;
}

// ---------- Menu and stock ----------

function findItem(MenuItem[] menu, string itemName) returns MenuItem? {
    foreach MenuItem item in menu {
        if item.itemName == itemName {
            return item;
        }
    }
    return ();
}

// How many of one dish an order asks for in total
function quantityOrdered(OrderItem[] items, string itemName) returns int {
    int total = 0;
    foreach OrderItem item in items {
        if item.itemName == itemName {
            total += item.quantity;
        }
    }
    return total;
}

// Checks that the restaurant is open and has every dish in stock, then takes
// the dishes out of stock. Returns the reason if the order must be rejected.
// The Kafka consumer handles orders one at a time, so two orders can never
// both take the last portion.
function reserveStock(ConfirmedOrder confirmedOrder) returns string?|error {
    mongodb:Collection restaurants = check restaurantsCollection();
    Restaurant? restaurant = check restaurants->findOne({restaurantId: confirmedOrder.restaurantId});
    if restaurant is () {
        return "Restaurant " + confirmedOrder.restaurantId + " is not registered";
    }

    boolean kitchenOpen = check isOpenNow(restaurant);
    if !kitchenOpen {
        return restaurant.name + " is closed (open " + restaurant.openingTime + " to "
            + restaurant.closingTime + ")";
    }

    foreach OrderItem ordered in confirmedOrder.items {
        MenuItem? menuItem = findItem(restaurant.menu, ordered.itemName);
        if menuItem is () {
            return ordered.itemName + " is not on the menu";
        }
        int wanted = quantityOrdered(confirmedOrder.items, ordered.itemName);
        if menuItem.stock < wanted {
            return "Not enough " + ordered.itemName + " in stock (" + menuItem.stock.toString() + " left)";
        }
    }

    MenuItem[] updatedMenu = from MenuItem menuItem in restaurant.menu
        select {
            itemName: menuItem.itemName,
            price: menuItem.price,
            stock: menuItem.stock - quantityOrdered(confirmedOrder.items, menuItem.itemName)
        };
    _ = check restaurants->updateOne(
        {restaurantId: restaurant.restaurantId},
        {set: {menu: updatedMenu.toJson()}}
    );
    return ();
}

// ---------- REST API ----------

service /restaurant on new http:Listener(8082) {

    resource function get health() returns string {
        return "Restaurant Service is alive";
    }

    // Register a restaurant and its kitchen hours (the menu starts empty)
    resource function post restaurants(NewRestaurant req) returns Restaurant|http:BadRequest|http:Conflict|error {
        if !validHours(req.openingTime, req.closingTime) {
            return <http:BadRequest>{body: {message: "Times must look like HH:MM, for example 08:30"}};
        }

        mongodb:Collection restaurants = check restaurantsCollection();
        Restaurant? existing = check restaurants->findOne({restaurantId: req.restaurantId});
        if existing is Restaurant {
            return <http:Conflict>{body: {message: "A restaurant with this ID already exists"}};
        }

        Restaurant newRestaurant = {
            restaurantId: req.restaurantId,
            name: req.name,
            openingTime: req.openingTime,
            closingTime: req.closingTime,
            menu: []
        };
        check restaurants->insertOne(newRestaurant);
        log:printInfo("Restaurant registered: " + req.restaurantId);
        return newRestaurant;
    }

    // View a restaurant, its menu with stock levels, and whether it is open now
    resource function get restaurants/[string restaurantId]() returns json|http:NotFound|error {
        mongodb:Collection restaurants = check restaurantsCollection();
        Restaurant? restaurant = check restaurants->findOne({restaurantId: restaurantId});
        if restaurant is () {
            return <http:NotFound>{body: {message: "Restaurant not found"}};
        }
        boolean openNow = check isOpenNow(restaurant);
        return {
            restaurantId: restaurant.restaurantId,
            name: restaurant.name,
            openingTime: restaurant.openingTime,
            closingTime: restaurant.closingTime,
            openNow: openNow,
            menu: restaurant.menu.toJson()
        };
    }

    // Change the kitchen hours
    resource function put restaurants/[string restaurantId]/hours(OpeningHours req)
            returns json|http:BadRequest|http:NotFound|error {
        if !validHours(req.openingTime, req.closingTime) {
            return <http:BadRequest>{body: {message: "Times must look like HH:MM, for example 08:30"}};
        }

        mongodb:Collection restaurants = check restaurantsCollection();
        mongodb:UpdateResult result = check restaurants->updateOne(
            {restaurantId: restaurantId},
            {set: {openingTime: req.openingTime, closingTime: req.closingTime}}
        );
        if result.matchedCount == 0 {
            return <http:NotFound>{body: {message: "Restaurant not found"}};
        }

        log:printInfo("Opening hours of " + restaurantId + " are now " + req.openingTime + "-" + req.closingTime);
        return {restaurantId: restaurantId, openingTime: req.openingTime, closingTime: req.closingTime};
    }

    // Add a dish to the menu, or change its price and stock
    resource function put restaurants/[string restaurantId]/menu/[string itemName](MenuItemUpdate req)
            returns MenuItem|http:BadRequest|http:NotFound|error {
        decimal lowestPrice = 0;
        if req.stock < 0 || req.price < lowestPrice {
            return <http:BadRequest>{body: {message: "Price and stock cannot be negative"}};
        }

        mongodb:Collection restaurants = check restaurantsCollection();
        Restaurant? restaurant = check restaurants->findOne({restaurantId: restaurantId});
        if restaurant is () {
            return <http:NotFound>{body: {message: "Restaurant not found"}};
        }

        MenuItem item = {itemName: itemName, price: req.price, stock: req.stock};
        MenuItem[] updatedMenu = from MenuItem existing in restaurant.menu
            select existing.itemName == itemName ? item : existing;
        if findItem(restaurant.menu, itemName) is () {
            updatedMenu = [...updatedMenu, item];
        }

        _ = check restaurants->updateOne(
            {restaurantId: restaurantId},
            {set: {menu: updatedMenu.toJson()}}
        );
        log:printInfo("Menu of " + restaurantId + ": " + itemName + " is N$" + req.price.toString()
            + ", stock " + req.stock.toString());
        return item;
    }

    // The kitchen marks an accepted order as ready for pickup
    resource function post orders/[string orderId]/ready() returns json|http:Conflict|error {
        mongodb:Collection acceptedOrders = check acceptedOrdersCollection();

        // Only an order this kitchen has accepted, and not yet marked ready, can become READY.
        // An unknown ID, or an order that is already READY, is refused and nothing is published.
        mongodb:UpdateResult updateResult = check acceptedOrders->updateOne(
            {orderId: orderId, status: "ACCEPTED"},
            {set: {status: "READY"}}
        );
        if updateResult.matchedCount == 0 {
            return <http:Conflict>{body: {orderId: orderId, message: "No accepted order with this ID is waiting to be prepared"}};
        }

        log:printInfo("Order marked READY: " + orderId);
        check publishEvent("restaurant.order.ready", orderId, {orderId: orderId, status: "READY"});
        return {orderId: orderId, status: "READY"};
    }
}

// ---------- Kafka consumer ----------

// orders.confirmed: accept the order if the kitchen can make it, otherwise reject it
listener kafka:Listener orderConfirmedListener = check new (kafkaBootstrap, {
    groupId: "restaurant-service-group",
    topics: ["orders.confirmed"]
});

service on orderConfirmedListener {
    remote function onConsumerRecord(kafka:Caller caller, kafka:BytesConsumerRecord[] records) returns error? {
        foreach kafka:BytesConsumerRecord rec in records {
            string messageContent = check string:fromBytes(rec.value);
            ConfirmedOrder confirmedOrder = check messageContent.fromJsonStringWithType(ConfirmedOrder);

            // Closed, dish not on the menu, or not enough stock: reject the order
            string? rejectionReason = check reserveStock(confirmedOrder);
            if rejectionReason is string {
                log:printWarn("Restaurant rejected order " + confirmedOrder.orderId + ": " + rejectionReason);
                check publishEvent("restaurant.order.rejected", confirmedOrder.orderId, {
                    orderId: confirmedOrder.orderId,
                    restaurantId: confirmedOrder.restaurantId,
                    status: "REJECTED",
                    reason: rejectionReason
                });
                continue;
            }

            mongodb:Collection acceptedOrders = check acceptedOrdersCollection();
            AcceptedOrder newAcceptedOrder = {
                orderId: confirmedOrder.orderId,
                restaurantId: confirmedOrder.restaurantId,
                items: confirmedOrder.items,
                status: "ACCEPTED"
            };
            check acceptedOrders->insertOne(newAcceptedOrder);
            log:printInfo("Restaurant accepted order: " + confirmedOrder.orderId);

            check publishEvent("restaurant.order.accepted", confirmedOrder.orderId,
                {orderId: confirmedOrder.orderId, status: "ACCEPTED"});
        }
    }
}
